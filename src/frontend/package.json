  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@swc/helpers": "0.5.24",
    "@types/canvas-confetti": "1.9.0",
    "@types/lodash": "4.17.27",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/wicg-file-system-access": "2023.10.7",
