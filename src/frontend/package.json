    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plus": "1.7.0",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx}": [
      "vp lint --fix --max-warnings=0",
      "vp fmt --no-error-on-unmatched-pattern"
    ],
    "**/*.{css,json,md,html}": [
      "vp fmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@swc/helpers": "0.5.24",
      "axios": "1.15.0",
      "dompurify": "3.3.2",
      "follow-redirects": ">=1.16.0",
      "lodash-es": "4.18.1",
      "minimatch": "9.0.7",
      "remark-mermaid-plugin>mermaid": "11.12.1",
      "rollup": ">=4.59.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
      "vitest": "5.1.1"
    }
  }
}
