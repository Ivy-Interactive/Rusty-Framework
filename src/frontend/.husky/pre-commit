#!/bin/sh

# Check for merge conflict markers in staged files
CONFLICT_FILES=$(git diff --cached --name-only | xargs grep -l -E '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null || true)
if [ -n "$CONFLICT_FILES" ]; then
  echo "ERROR: Merge conflict markers detected in staged files!"
  echo ""
  git diff --cached --name-only | xargs grep -n -E '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null
  echo ""
  echo "Please resolve all conflicts before committing."
  exit 1
fi

# Check formatting of staged Rust files
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -n "$RUST_FILES" ]; then
  if command -v rustfmt >/dev/null 2>&1; then
    echo "Formatting staged Rust files..."
    echo "$RUST_FILES" | xargs rustfmt --edition 2021 --config skip_children=true
    echo "$RUST_FILES" | xargs git add
  else
    echo "rustfmt not found on PATH, skipping Rust format check."
  fi
fi

# Compile-class gates for merge resolutions (no-op for ordinary commits).
sh -e "$(git rev-parse --show-toplevel)/scripts/precommit-rust-gates.sh"

# Check if any frontend files are staged
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^src/frontend/" || true)

if [ -n "$FRONTEND_FILES" ]; then
  echo "Running Vite+ linter and formatter on staged frontend files..."
  cd src/frontend
  if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: node is not on PATH; the frontend pre-commit lint cannot run."
    echo "Install Node.js (or activate your version manager) and retry."
    echo "To bypass deliberately: git commit --no-verify"
    exit 1
  fi
  vp exec lint-staged -- --relative
else
  echo "No frontend files staged, skipping lint-staged."
fi
